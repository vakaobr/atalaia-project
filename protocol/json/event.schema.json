  "$defs": {
    "data": {
      "team": {
        "type": "string",
        "description": "team name"
      },
      "squad": {
        "type": "string",
        "description": "squad name"
      },
      "reason": {
        "type": "string",
        "description": "why it happened"
      },
      "previous_team": {
        "type": "string",
        "description": "team that owned the zone before"
      },
      "zone": {
        "type": "string",
        "description": "zone name"
      },
      "amount": {
        "type": "integer",
        "description": "points; negative for penalties"
      },
      "fuse_s": {
        "type": "number",
        "description": "fuse length in seconds"
      },
      "winner": {
        "type": "string",
        "description": "winning team name"
      },
      "preset": {
        "type": "string",
        "description": "preset id"
      },
      "code": {
        "type": "string",
        "description": "code id"
      },
      "kind": {
        "type": "string",
        "description": "code kind: hint, points, unlock"
      },
      "tag": {
        "type": "string",
        "description": "NFC tag id"
      },
      "owner": {
        "type": "string",
        "description": "tag owner: team or player"
      },
      "player": {
        "type": "string",
        "description": "player id"
      },
      "lives_left": {
        "type": "integer",
        "description": "lives remaining"
      },
      "window_open": {
        "type": "boolean",
        "description": "the target's scoring window was open"
      },
      "text": {
        "type": "string",
        "description": "message text"
      },
      "audience": {
        "type": "string",
        "description": "who sees the message"
      },
      "message": {
        "type": "string",
        "description": "error message"
      },
      "percent": {
        "type": "integer",
        "description": "battery level in percent"
      },
      "fw": {
        "type": "string",
        "description": "firmware version"
      },
      "tier": {
        "type": "string",
        "description": "device tier"
      },
      "last_seen": {
        "type": "integer",
        "description": "game time of the last contact, in ms"
      },
      "replica": {
        "type": "string",
        "description": "replica id"
      },
      "reading_mps": {
        "type": "number",
        "description": "chrono reading in m/s"
      },
      "bb_g": {
        "type": "number",
        "description": "BB weight in grams"
      },
      "limit_j": {
        "type": "number",
        "description": "energy limit in joules"
      },
      "duration_s": {
        "type": "number",
        "description": "countdown or visibility duration in seconds"
      },
      "see_team": {
        "type": "string",
        "description": "team whose positions become visible"
      },
      "tolerance_pct": {
        "type": "number",
        "description": "chrono comparison tolerance in percent"
      },
      "holder": {
        "type": "string",
        "description": "team holding the node when it happened"
      },
      "remaining": {
        "type": "integer",
        "description": "uses left, such as a medic kit's heals"
      },
      "player_heals_used": {
        "type": "integer",
        "description": "heals a player has had in this game"
      },
      "objective": {
        "type": "string",
        "description": "scenario objective id"
      },
      "scenario": {
        "type": "string",
        "description": "scenario package id"
      },
      "puzzle": {
        "type": "string",
        "description": "hacking terminal puzzle: code, wires or sequence"
      },
      "release": {
        "type": "string",
        "description": "firmware release id: the first 16 hex digits of the image's SHA-256"
      },
      "mode": {
        "type": "string",
        "description": "mode package id: one part of a game's mode id"
      },
      "step": {
        "type": "integer",
        "description": "a box's place in a sequence of boxes, from 1 (Progressive Domination)"
      }
    }
  }
