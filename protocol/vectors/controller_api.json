          {"id": "org.atalaia.holdall", "field_script": true, "params": {"min_zones": {"default": 2}}},
          {"id": "org.atalaia.hacking_terminal", "params": {"reveal_code": {"gm_only": true}}, "commands": {"reset": {"roles": ["terminal"]}}}
        ]}},
        {"request": {"method": "GET", "path": "/api/v1/modes", "token": "none"}, "status": 401}
      ]
    },
