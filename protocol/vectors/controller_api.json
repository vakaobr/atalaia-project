  "mqtt_acl": {
    "description": "Who may read and write which topics on the controller's MQTT broker: the Pi's Mosquitto ACL (controller/deploy/atalaia.acl, checked by controller/tests/test_api_contract.py) and the Android controller's embedded broker (app/lib/controller/mqtt_broker.dart, MqttAcl.field, checked by app/test/controller/api_contract_test.dart). Users: 'gm' (GM tools: reads everything, publishes commands), 'reader' (scoreboards: events, score and nodes) and 'controller' (the field controller itself). A user not listed may do nothing.",
    "users": ["gm", "reader"],
    "checks": [
      {"user": "reader", "topic": "field/v1/3/score", "read": true, "write": false},
      {"user": "reader", "topic": "field/v1/3/events/zone.captured", "read": true, "write": false},
      {"user": "reader", "topic": "field/v1/3/nodes/4/state", "read": true, "write": false},
      {"user": "reader", "topic": "field/v1/3/nodes/4/health", "read": true, "write": false},
      {"user": "reader", "topic": "field/v1/3/cmd/4", "read": false, "write": false},
      {"user": "reader", "topic": "field/v1/3/cmd/all", "read": false, "write": false},
      {"user": "reader", "topic": "field/v1/3/score/x", "read": false, "write": false},
      {"user": "reader", "topic": "field/v2/3/score", "read": false, "write": false},
      {"user": "gm", "topic": "field/v1/3/score", "read": true, "write": false},
      {"user": "gm", "topic": "field/v1/3/events/game.end", "read": true, "write": false},
      {"user": "gm", "topic": "field/v1/3/nodes/4/state", "read": true, "write": false},
      {"user": "gm", "topic": "field/v1/3/cmd/4", "read": true, "write": true},
      {"user": "gm", "topic": "field/v1/3/cmd/all", "read": true, "write": true},
      {"user": "gm", "topic": "other/topic", "read": false, "write": false},
      {"user": "controller", "topic": "field/v1/3/score", "read": true, "write": true},
      {"user": "controller", "topic": "field/v1/3/cmd/4", "read": true, "write": true},
      {"user": "someone", "topic": "field/v1/3/score", "read": false, "write": false}
    ]
  }
