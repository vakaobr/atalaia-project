# SPDX-FileCopyrightText: 2026 The Atalaia contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# ESP32-S3 target defaults for the Atalaia Field Box.
# Default board: Heltec WiFi LoRa 32 V4 (ESP32-S3R2, 2 MB PSRAM,
# 16 MB flash, SX1262 radio).  See ADR-P1-4 (partition layout),
# ADR-P1-1 (pin assignments) and IMPLEMENTATION.md.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash (16 MB on Heltec V4) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Partition table (custom, see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM (2 MB quad on Heltec V4) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Wi-Fi memory (firmware updates, setup portal) ---
# Wi-Fi's static TX/RX buffers and LwIP's are allocated in PSRAM: with the
# game's tasks, the radio, the lobby, pairing and LVGL in internal RAM, the
# 16 static TX buffers (~26 KB up front) no longer fitted there and the
# driver failed to start (found on the bench, 2026-10-22). ESP-IDF keeps the
# TX buffers static with this option, so there is no TX buffer type to set.
# The static RX buffers must stay in internal RAM (DMA); the option raises
# their default to 16 (~26 KB), which did not fit either: 6 here, and the
# dynamic RX buffers cover bursts (one image download at a time).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Ordinary allocations above 4 KB go to PSRAM (ESP-IDF's default keeps up to
# 16 KB internal), leaving internal RAM to the drivers that need DMA.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
# Even so the driver ran out at its RX buffers with 47 KB of DMA-capable RAM
# free before it started: fewer static TX buffers (one HTTPS download at a
# time), and no Wi-Fi code in IRAM (~27 KB of internal RAM; throughput does
# not matter for an image fetched between games).
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# mbedTLS allocates in PSRAM (ESP-IDF's default is internal RAM only): the
# TLS session's 16 KB input buffer and the ECDSA check of the controller's
# certificate failed there with MBEDTLS_ERR_MPI_ALLOC_FAILED (bench,
# 2026-10-22). Slower TLS, for one download between games.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- Internal RAM budget (README.md, "Memory budget") ---
# The Field Box's internal RAM is what Wi-Fi (DMA RX buffers, driver state), the Bluetooth
# controller, the display's DMA draw buffers and every task stack share. On the bench (2026-10-29)
# it was gone at a game's join: 11 KB of DMA RAM free with the beacon, 36 KB without it, where the
# Wi-Fi driver needs about 47 KB. The game's big static buffers and LVGL's 48 KB widget heap were
# in .bss, i.e. in internal RAM, ~110 KB of it; they live in PSRAM now (ATALAIA_PSRAM_BSS in
# main/psram_attr.h, LV_ATTRIBUTE_LARGE_RAM_ARRAY in lvgl_conf/lv_conf.h). Only zero-initialised
# statics that tasks use, never an ISR, a DMA buffer or an SPI buffer. The Wokwi, modem and pod
# images turn this off (no PSRAM guaranteed, or no need).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- System ---
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Compiler ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Firmware updates over the air (protocol/firmware-update.md) ---
# An image a firmware update installed must confirm itself after its self-test
# (fw_update_esp_boot); if it crashes or reboots first, the bootloader goes back
# to the previous image. Changes the bootloader: flash it once over USB
# (BRING_UP.md). For production, ESP-IDF's secure version in eFuse
# (CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK, with secure boot) would add a hardware
# anti-rollback under the box's own version check (decision FU3-8).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Bluetooth LE: the Field Box's iBeacon (decisions BBC-1 to BBC-12) ---
# A broadcaster only: NimBLE advertises one non-connectable packet while the box is joined to a
# game (main/box_beacon_esp.c) and is taken down again, controller memory included, when the game
# ends. No connection, no scan, no pairing and no bond store, so the host is the smallest NimBLE
# builds; its heap goes to PSRAM (the internal RAM is spoken for: see the Wi-Fi notes above).
# The I/O pod (sdkconfig.pod) and the modem and Wokwi variants set their own, after this file.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# (ESP-IDF 5.3.2's ble_gap.c does not compile as a broadcaster alone: it needs the peripheral role,
# which stays unused; the advertisement is non-connectable.)
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# The controller's own memory (internal RAM, released with the controller when the beacon stops):
# one advertiser needs two activities at most, and the scan duplicate filter and the advertising-report
# flow control are for scanners (this box never scans).
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_SUPP=n
