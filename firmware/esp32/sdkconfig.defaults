#
# ESP32-S3 target defaults for the Atalaia Field Box.
# Default board: Heltec WiFi LoRa 32 V4 (ESP32-S3R2, 2 MB PSRAM,
# 16 MB flash, SX1262 radio).  See ADR-P1-4 (partition layout),
# ADR-P1-1 (pin assignments) and IMPLEMENTATION.md.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash (16 MB on Heltec V4) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Partition table (custom, see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM (2 MB quad on Heltec V4) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000

# --- System ---
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Compiler ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Firmware updates over the air (protocol/firmware-update.md) ---
# An image a firmware update installed must confirm itself after its self-test
# (fw_update_esp_boot); if it crashes or reboots first, the bootloader goes back
# to the previous image. Changes the bootloader: flash it once over USB
# (BRING_UP.md). For production, ESP-IDF's secure version in eFuse
# (CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK, with secure boot) would add a hardware
# anti-rollback under the box's own version check (decision FU3-8).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
