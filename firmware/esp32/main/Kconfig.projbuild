#
# Pin assignments and tuning knobs for the Atalaia Field Box.
# Default board: Heltec WiFi LoRa 32 V4.3 (ESP32-S3R2, 16 MB flash,
# 2 MB PSRAM, SX1262 LoRa radio, KCT8103L front-end module, 0.96" OLED).
# The V4.2 (GC1109 front-end module) is selected under Radio > Board revision.
#
# Board-internal pins -- DO NOT reassign:
#   1 (Vbat ADC), 2 (FEM_EN), 7 (VFEM_Ctrl: the FEM's LDO), 8-14 (SX1262),
#   17-18 (OLED I2C), 19-20 (USB), 21 (OLED RST), 35 (LED),
#   36 (Vext_Ctrl, active low), 37 (ADC_Ctrl), 43-44 (UART0 console),
#   5 on the V4.3 (KCT8103L CTX: receive LNA or bypass),
#   46 on the V4.2 (GC1109 CPS: PA or bypass).
#   (Button 2 moved from GPIO 5 to GPIO 39 for the V4.3.)
#
# ESP32-S3 strapping pins:
#   GPIO 0  -- boot mode (PRG button on V4.3). Do not use.
#   GPIO 3  -- JTAG TMS.  Used here for DISP_DC; disables JTAG.
#              Safe: JTAG is not needed in production; internal pull-up
#              selects normal (non-JTAG) operation at reset.
#   GPIO 45 -- VDD_SPI voltage.  NOT used.  An external pull-up here
#              selects 1.8 V flash and prevents booting.
#   GPIO 46 -- boot log verbosity.  NOT used in default config.
#              An external pull-up suppresses boot log (harmless).
#
# GNSS header (34, 38-42): the V4 ships with a GNSS module for its SH1.25
# connector (34 = VGNSS_Ctrl, the module's power; 38-42 = its UART, wake,
# PPS and reset). The Field Box uses these pins for the display and the
# buttons instead: GPS is NOT supported in this pin map -- do not plug the
# GNSS module in. Button 4 on GPIO 34 shares the GNSS power control: with
# no module fitted, pressing it only switches the empty connector's
# supply. The pin map is to be revisited when GPS-based modes arrive (phase 4).
# NFC/battery/keypad share the OLED I2C bus (17/18):
#   0x20 (PCF8574 keypad), 0x24 (PN532 NFC), 0x36 (MAX17048), 0x3C (OLED).
#
# Convention: -1 means "unassigned / peripheral not wired".

menu "Atalaia Field Box Configuration"

    # ---- Buttons (active-low GPIOs) -----------------------------------------
    menu "Buttons"
        config ATALAIA_BTN1_PIN
            int "Button 1 GPIO (-1 = unused)"
            default 4

        config ATALAIA_BTN2_PIN
            int "Button 2 GPIO (-1 = unused)"
            default 39
            help
                GPIO 39 (on the GNSS header, freed from the keypad matrix by
                the PCF8574). Not GPIO 5: on the Heltec V4.3, GPIO 5 is the
                front-end module's receive-path control (CTX).

        config ATALAIA_BTN3_PIN
            int "Button 3 GPIO (-1 = unused)"
            default 33
            help
                GPIO 33, freed from the keypad matrix by the PCF8574
                I2C expander. Set to -1 for 2-team play.

        config ATALAIA_BTN4_PIN
            int "Button 4 GPIO (-1 = unused)"
            default 34
            help
                GPIO 34, freed from the keypad matrix by the PCF8574
                I2C expander. Set to -1 for 2- or 3-team play.
    endmenu

    # ---- PCF8574 I2C keypad expander ------------------------------------------
    # The 4x3 matrix keypad is wired through a PCF8574 on the shared OLED
    # I2C bus (GPIO 17/18). Rows on P0-P3, columns on P4-P6, P7 unused.
    # This frees GPIOs 6, 15, 16, 33, 34, 38, 39 for audio, buttons, etc.
    menu "Keypad"
        choice ATALAIA_KP_INTERFACE
            prompt "Keypad interface"
            default ATALAIA_KP_PCF8574
            help
                How the 4x3 keypad is wired. The Field Box uses the PCF8574
                expander. The GPIO matrix exists for the Wokwi emulator
                (sdkconfig.wokwi), which has no PCF8574 part.

            config ATALAIA_KP_PCF8574
                bool "PCF8574 I2C expander (Field Box)"

            config ATALAIA_KP_GPIO_MATRIX
                bool "Direct GPIO matrix (Wokwi emulator)"
        endchoice

        config ATALAIA_KP_ROW0_PIN
            int "Keypad row 1 GPIO (rows are outputs)"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 6
        config ATALAIA_KP_ROW1_PIN
            int "Keypad row 2 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 15
        config ATALAIA_KP_ROW2_PIN
            int "Keypad row 3 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 16
        config ATALAIA_KP_ROW3_PIN
            int "Keypad row 4 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 7
        config ATALAIA_KP_COL0_PIN
            int "Keypad column 1 GPIO (columns are inputs with pull-ups)"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 1
        config ATALAIA_KP_COL1_PIN
            int "Keypad column 2 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 2
        config ATALAIA_KP_COL2_PIN
            int "Keypad column 3 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 39

        config ATALAIA_KP_I2C_ADDR
            hex "PCF8574 I2C address"
            depends on ATALAIA_KP_PCF8574
            default 0x20
            help
                7-bit I2C address of the PCF8574 keypad expander.
                Common values: 0x20-0x27 (A0-A2 address pins).

        config ATALAIA_KP_INT_PIN
            int "PCF8574 INT GPIO (-1 = poll)"
            depends on ATALAIA_KP_PCF8574
            default -1
            help
                Optional interrupt pin from the PCF8574.  When set
                the driver can skip I2C polls when no key change has
                occurred.  Set to -1 to always poll (default).
    endmenu

    # ---- WS2812B LED strip --------------------------------------------------
    menu "LEDs"
        config ATALAIA_LED_PIN
            int "LED data GPIO"
            default 48

        config ATALAIA_LED_COUNT
            int "Number of LEDs"
            default 24

        config ATALAIA_LED_BRIGHTNESS_PCT
            int "LED ring brightness at boot (percent)"
            default 40
            range 1 100
            help
                WS2812 LEDs have no brightness control of their own: the
                driver scales every colour. A 24-LED ring at full white
                draws about 1.4 A from the battery; modes can change the
                brightness with ring:set_brightness(percent).
    endmenu

    # ---- SPI display --------------------------------------------------------
    menu "Display"
        config ATALAIA_DISP_MOSI_PIN
            int "Display SPI MOSI GPIO"
            default 40
            help
                GPIO 40 is on the GNSS header.

        config ATALAIA_DISP_CLK_PIN
            int "Display SPI CLK GPIO"
            default 41

        config ATALAIA_DISP_CS_PIN
            int "Display SPI CS GPIO"
            default 42

        config ATALAIA_DISP_DC_PIN
            int "Display DC GPIO"
            default 3
            help
                GPIO 3 is an ESP32-S3 JTAG strapping pin. Using it
                for display DC disables the JTAG debug interface.
                Safe: internal pull-up selects non-JTAG mode at reset.

        config ATALAIA_DISP_RST_PIN
            int "Display RST GPIO (-1 = tied to Vext)"
            default 38
            help
                GPIO 38, freed from the keypad matrix by the PCF8574
                I2C expander (on the GNSS header). Set to -1 when the
                display RST is wired to Vext_Ctrl (GPIO 36) instead.

        config ATALAIA_DISP_BL_PIN
            int "Display backlight GPIO (-1 = always on via Vext)"
            default 47
            help
                GPIO 47 is not a strapping pin. Safe for output.
                Set to -1 to omit software backlight control (the
                backlight stays on whenever Vext is high).

        choice ATALAIA_DISP_CONTROLLER
            prompt "Display controller IC"
            default ATALAIA_DISP_ILI9341

            config ATALAIA_DISP_ILI9341
                bool "ILI9341"

            config ATALAIA_DISP_ST7789
                bool "ST7789"
        endchoice
    endmenu

    # ---- NFC (PN532 over I2C, shared bus with OLED and battery gauge) -------
    menu "NFC"
        config ATALAIA_NFC_SDA_PIN
            int "NFC I2C SDA GPIO"
            default 17
            help
                Shares the on-board OLED I2C bus. The PN532 (0x24),
                OLED (0x3C) and MAX17048 (0x36) coexist on this bus.

        config ATALAIA_NFC_SCL_PIN
            int "NFC I2C SCL GPIO"
            default 18
    endmenu

    # ---- I2S audio (MAX98357A) ----------------------------------------------
    # GPIOs 6, 15, 16 are freed from the keypad matrix by the PCF8574
    # I2C expander and reassigned here.
    menu "Audio"
        config ATALAIA_AUDIO_BCLK_PIN
            int "I2S bit-clock GPIO (-1 = audio disabled)"
            default 6
            help
                GPIO 6, freed from keypad. Non-strapping, safe for I2S.

        config ATALAIA_AUDIO_LRCLK_PIN
            int "I2S LR-clock GPIO (-1 = audio disabled)"
            default 15
            help
                GPIO 15, freed from keypad. Non-strapping.

        config ATALAIA_AUDIO_DOUT_PIN
            int "I2S data-out GPIO (-1 = audio disabled)"
            default 16
            help
                GPIO 16, freed from keypad. Non-strapping.
    endmenu

    # ---- Battery gauge (MAX17048 over I2C, shared bus with NFC and OLED) ----
    menu "Battery"
        config ATALAIA_BATT_SDA_PIN
            int "Battery gauge I2C SDA GPIO"
            default 17
            help
                Shares the OLED I2C bus.

        config ATALAIA_BATT_SCL_PIN
            int "Battery gauge I2C SCL GPIO"
            default 18
    endmenu

    # ---- SX1262 LoRa radio (Heltec V4.3 on-board) ---------------------------
    # The SX1262 is on the board's own SPI bus (separate from the display).
    # These are the V4.3 schematic pin assignments.
    menu "Radio"
        config ATALAIA_RADIO_NSS_PIN
            int "SX1262 SPI NSS (CS) GPIO"
            default 8

        config ATALAIA_RADIO_SCK_PIN
            int "SX1262 SPI SCK GPIO"
            default 9

        config ATALAIA_RADIO_MOSI_PIN
            int "SX1262 SPI MOSI GPIO"
            default 10

        config ATALAIA_RADIO_MISO_PIN
            int "SX1262 SPI MISO GPIO"
            default 11

        config ATALAIA_RADIO_RST_PIN
            int "SX1262 RST GPIO"
            default 12

        config ATALAIA_RADIO_BUSY_PIN
            int "SX1262 BUSY GPIO"
            default 13

        config ATALAIA_RADIO_DIO1_PIN
            int "SX1262 DIO1 GPIO"
            default 14

        choice ATALAIA_BOARD_REV
            prompt "Board revision (radio front-end module)"
            default ATALAIA_BOARD_HELTEC_V4_3
            help
                The Heltec WiFi LoRa 32 V4 has two front-end modules between
                the SX1262 and the antenna. Read the chip next to the LoRa
                antenna connector (BRING_UP.md step 0): KCT8103L = V4.3,
                GC1109 = V4.2. The wrong choice leaves the receiver deaf or
                the transmitter weak. Applies to the Field Box and the USB
                radio modem.

            config ATALAIA_BOARD_HELTEC_V4_3
                bool "Heltec V4.3 (KCT8103L)"

            config ATALAIA_BOARD_HELTEC_V4_2
                bool "Heltec V4.2 (GC1109)"
        endchoice

        config ATALAIA_RADIO_FEM_EN_PIN
            int "FEM chip enable GPIO (FEM_EN, high = on)"
            default 2
            help
                Board-internal: do not reassign. The front-end module's chip
                enable on both V4 revisions.

        config ATALAIA_RADIO_VFEM_CTL_PIN
            int "FEM power GPIO (VFEM_Ctrl, high = powered)"
            default 7
            help
                Board-internal: do not reassign. Switches the LDO that
                powers the front-end module on both V4 revisions; it must be
                high whenever the radio is used. Driven only after the
                SX1262 answers its probe (the Wokwi emulator uses GPIO 7 for
                its keypad).

        config ATALAIA_RADIO_FEM_PA_PIN
            int "GC1109 PA select GPIO (CPS, high = full PA)"
            depends on ATALAIA_BOARD_HELTEC_V4_2
            default 46
            help
                Board-internal on the V4.2: high selects the power amplifier
                (low would bypass it). The SX1262's DIO2 drives the TX/RX
                switch, so no TXEN/RXEN pins are used.

        config ATALAIA_RADIO_FEM_CTX_PIN
            int "KCT8103L receive path GPIO (CTX, low = LNA)"
            depends on ATALAIA_BOARD_HELTEC_V4_3
            default 5
            help
                Board-internal on the V4.3: low puts the receive LNA (about
                21 dB) in the path, high bypasses it. The SX1262's DIO2
                drives the TX/RX switch.

        config ATALAIA_RADIO_FEM_GAIN_DB
            int "FEM gain in dB (for TX power calculation)"
            default 14
            help
                The front-end module provides approximately this much gain.
                Conducted TX power = ERP_limit + 2.15 - FEM_gain - antenna_gain,
                clamped to the SX1262 range [-9, +22] dBm.

        config ATALAIA_RADIO_ANTENNA_GAIN_DBI
            int "Antenna gain in dBi"
            default 2
            help
                Gain of the connected antenna in dBi. A typical stock
                omnidirectional antenna is 2 dBi. This value is subtracted
                from the EIRP limit together with the FEM gain to compute
                the SX1262 conducted TX power. Measure with a calibrated
                antenna analyser for production; the default is a
                conservative estimate for a quarter-wave whip.

        choice ATALAIA_RADIO_REGION
            prompt "Radio regulatory region"
            default ATALAIA_RADIO_REGION_EU868

            config ATALAIA_RADIO_REGION_EU868
                bool "EU868 (Europe)"
        endchoice

        config ATALAIA_RADIO_DEFAULT_CHANNEL_HZ
            int "Default game channel frequency (Hz)"
            default 869525000
            help
                The frequency all nodes TX and RX on. Default 869.525 MHz
                (g2 sub-band, 10% duty cycle, 500 mW ERP). Configurable per
                game via CONFIG message. Must be within an EU868 sub-band.
    endmenu

    # ---- Board power ----------------------------------------------------------
    menu "Board power"
        config ATALAIA_VEXT_CTL_PIN
            int "Vext control GPIO (active low, -1 = leave alone)"
            default 36
            help
                Board-internal on the Heltec V4: driving GPIO 36 low switches
                on Vext, the rail for the on-board OLED and the LoRa front
                end (and for external parts wired to it; the standard Field
                Box wiring powers them from 3V3). The firmware drives it low
                early at boot, before anything is probed.
    endmenu

    # ---- Joined games (ADR-P2-12, protocol/join.md) -------------------------
    menu "Field network games"
        config ATALAIA_STATE_INTERVAL_S
            int "Seconds between STATE packets in a joined game"
            default 15
            range 5 300
            help
                A box in a field controller's game sends its owner, phase,
                game time and score counters this often (and at once after
                a capture). 15 s keeps a 5-box game far below the 10% duty
                cycle of the 869.4-869.65 MHz sub-band.

        config ATALAIA_CONSOLE_USB_INPUT
            bool "Read the serial console's input from the USB port (USB-Serial-JTAG)"
            default y
            depends on !ATALAIA_MODEM_MODE
            help
                The Heltec V4 has no USB-UART bridge: its USB-C port is the
                ESP32-S3's own USB-Serial-JTAG. With this on, "@join",
                "@joinkey" and (with ATALAIA_SERIAL_KEYS) keys typed in a
                serial monitor on that port reach the box, as well as those
                on UART0. Off in the Wokwi build, whose console is UART0.

        config ATALAIA_SERIAL_JOIN
            bool "Accept @join, @joinkey and @tag lines on the serial console"
            default y
            help
                "@join atalaia:join:..." joins a game from the text of a join
                payload (the GM console shows it), "@joinkey <64 hex>"
                sets the field join key while no game is joined, and
                "@tag <uid hex> [<tag hex>]" reads a player tag (protocol/nfc-tag.md)
                as if it had been tapped on the NFC reader. For bring-up and the
                Wokwi emulator; a join still needs a payload signed with this
                box's field join key, and a tag one signed with the game key.

        config ATALAIA_DEV_JOIN_KEY
            string "Development field join key (64 hex digits)"
            default ""
            help
                Used only when no field join key is stored in NVS: for the
                Wokwi emulator and the bench. Leave empty on Field Boxes, which
                get the field's key once, with "@joinkey" or (later) the setup
                portal; `python -m atalaia_controller join-key` prints it.
    endmenu

    # ---- USB radio modem (ADR-P2-4) -----------------------------------------
    menu "USB radio modem"
        config ATALAIA_MODEM_MODE
            bool "Build the USB radio modem instead of the Field Box firmware"
            default n
            help
                The controller's radio: a Heltec V4.3 plugged into the field
                controller (Raspberry Pi) over USB. Radio, AES-CCM, dedupe and
                duty cycle run here; no Lua, screens or presets. Selected by
                sdkconfig.modem (python tools/docker_fw.py modem). The frames
                on the serial link are specified in protocol/usb-modem.md.

        choice ATALAIA_MODEM_LINK
            prompt "Serial link to the controller"
            default ATALAIA_MODEM_LINK_USB_SERIAL_JTAG
            depends on ATALAIA_MODEM_MODE
            help
                The ESP32-S3's built-in USB-Serial-JTAG port (GPIO 19/20), or
                UART0 (GPIO 43/44) for boards with a USB-UART bridge chip.
                With UART0 the console must move off UART0
                (CONFIG_ESP_CONSOLE_NONE or USB_SERIAL_JTAG).

            config ATALAIA_MODEM_LINK_USB_SERIAL_JTAG
                bool "USB-Serial-JTAG (native USB)"

            config ATALAIA_MODEM_LINK_UART0
                bool "UART0 (USB-UART bridge on GPIO 43/44)"
        endchoice

        config ATALAIA_MODEM_UART_BAUD
            int "UART0 baud rate"
            default 921600
            depends on ATALAIA_MODEM_LINK_UART0

        config ATALAIA_MODEM_EPOCH_WINDOW
            int "Receive epoch window"
            default 16
            range 1 64
            depends on ATALAIA_MODEM_MODE
            help
                How many epochs above a box's last known epoch the modem
                tries when a packet does not authenticate (ADR-P2-2 tries
                only one). A box that rebooted several times out of range
                would otherwise never be heard again. Never a lower epoch.
    endmenu

    # ---- Development and emulator options -----------------------------------
    menu "Development"
        config ATALAIA_RADIO_DISABLE
            bool "Disable SX1262 radio HAL (Wokwi emulator)"
            default n
            help
                Skip all radio SPI and GPIO initialisation at boot. Use this
                on the Wokwi emulator, whose DevKitC-1 part has no SX1262
                and whose flash emulation does not tolerate probing SPI3.

        config ATALAIA_RADIO_DEBUG_STEP
            int "Radio init debug bisect step (0 = normal, 1-6 = stop after step N)"
            default 0
            depends on !ATALAIA_RADIO_DISABLE
            help
                Bisect the radio init for Wokwi debugging. 0 = normal full
                init. 1 = SPI bus init only. 2 = + SPI device add. 3 = + GPIO
                config (RST, BUSY, DIO1 without ISR). 4 = + DIO1 ISR install.
                5 = + reset pulse and BUSY wait. 6 = + first SPI transaction
                (SyncWord probe). Remove or set to 0 for production.

        config ATALAIA_SKIP_SETUP
            bool "Skip the Wi-Fi setup portal (use default settings)"
            default n
            help
                Boot straight into the preset picker with the default admin
                PIN (1234) instead of opening the setup portal on first boot.
                For the Wokwi emulator, which cannot host a SoftAP. Leave off
                on real Field Boxes.

        config ATALAIA_SERIAL_KEYS
            bool "Accept keypad keys from the serial console"
            default n
            help
                Characters 0-9, * and # typed on the USB serial console act
                as keypad presses. Lets the Wokwi automation scenarios and a
                bring-up session drive the picker without touching the keypad.
    endmenu

    # ---- Memory tier --------------------------------------------------------
    choice ATALAIA_MEMORY_TIER
        prompt "Lua heap memory tier"
        default ATALAIA_MEMORY_TIER_FULL

        config ATALAIA_MEMORY_TIER_FULL
            bool "Full (256 KB)"
            help
                Allocates 256 KB for the Lua sandbox heap.
                Requires PSRAM; falls back to reduced tier at runtime
                if PSRAM is not detected.

        config ATALAIA_MEMORY_TIER_REDUCED
            bool "Reduced (64 KB)"
            help
                Allocates 64 KB for the Lua sandbox heap.
                Suitable for boards without PSRAM (e.g. Heltec V3).
    endchoice

endmenu
