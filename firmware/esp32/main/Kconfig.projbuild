# SPDX-FileCopyrightText: 2026 The Atalaia contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Pin assignments and tuning knobs for the Atalaia Field Box.
# Default board: Heltec WiFi LoRa 32 V4.3 (ESP32-S3R2, 16 MB flash,
# 2 MB PSRAM, SX1262 LoRa radio, KCT8103L front-end module, 0.96" OLED).
# The V4.2 (GC1109 front-end module) is selected under Radio > Board revision.
#
# Board-internal pins -- DO NOT reassign:
#   0 (PRG button), 2 (FEM_EN), 7 (VFEM_Ctrl: the FEM's LDO), 8-14 (SX1262),
#   17-18 (OLED I2C), 19-20 (USB), 21 (OLED RST), 26-32 (flash and PSRAM),
#   34 (VGNSS_Ctrl: the GNSS connector's power, active low),
#   36 (Vext_Ctrl, active low), 37 (ADC_Ctrl),
#   38-42 (GNSS connector: UART, wake-up, PPS, reset), 43 (UART0 TX: console),
#   5 on the V4.3 (KCT8103L CTX: receive LNA or bypass),
#   46 on the V4.2 (GC1109 CPS: PA or bypass).
#
# Board pins the Field Box shares on purpose (tools/check_wiring.py allows
# only these uses; decisions PIN-3 to PIN-5):
#   1  -- the battery-voltage ADC input (VBAT_Read). Display CS: an output
#         only. The board's divider leaves 100 kohm to GND on it, which an
#         output does not mind; the firmware never reads the battery there
#         (the MAX17048 gauge does).
#   35 -- the board's white LED. LED ring data: the white LED flickers
#         faintly while the ring is updated.
#   44 -- UART0 RX. Button 3: the box then takes no console input on UART0
#         (the USB port's console is unaffected; logs still go out on 43).
#
# ESP32-S3 strapping pins:
#   GPIO 0  -- boot mode (PRG button on V4.3). Do not use.
#   GPIO 3  -- JTAG source select, ignored unless an eFuse (not burnt on
#              the V4) asks for it. Used here for DISP_DC.
#   GPIO 45 -- VDD_SPI voltage.  NOT used.  An external pull-up here
#              selects 1.8 V flash and prevents booting.
#   GPIO 46 -- boot log verbosity.  NOT used (and the V4.2's FEM PA line).
#
# GNSS connector (SH1.25, 8 pins): the module that comes with the V4 plugs in
# there and keeps all its pins (decision PIN-1; Heltec's V4 pin map and V4.3.1
# datasheet): 34 = VGNSS_Ctrl (low = module powered; the board pulls it high),
# 38 = the module's RX (ESP32 TX), 39 = the module's TX (ESP32 RX),
# 40 = wake-up, 41 = PPS, 42 = reset. The firmware keeps the module off
# (GNSS menu) until a mode needs a position; no driver yet.
# Button 4 is on the keypad expander's spare pin P7 (ATALAIA_KP_P7_BUTTON).
#
# NFC/battery/keypad share the OLED I2C bus (17/18):
#   0x20 (PCF8574 keypad), 0x24 (PN532 NFC), 0x36 (MAX17048), 0x3C (OLED).
#
# Convention: -1 means "unassigned / peripheral not wired".

menu "Atalaia Field Box Configuration"

    # ---- Firmware variant (ADR-P2-4, ADR-P3-3) ---------------------------------
    choice ATALAIA_DEVICE_MODE
        prompt "Firmware variant"
        default ATALAIA_NODE_MODE
        help
            One ESP-IDF project, three images: the Field Box, the field
            controller's USB radio modem (sdkconfig.modem, python
            tools/docker_fw.py modem) and the I/O pod that lends its hardware
            to a phone (sdkconfig.pod, python tools/docker_fw.py pod).

        config ATALAIA_NODE_MODE
            bool "Field Box"

        config ATALAIA_MODEM_MODE
            bool "USB radio modem"
            help
                The controller's radio: a Heltec V4.3 plugged into the field
                controller (Raspberry Pi) over USB. Radio, AES-CCM, dedupe and
                duty cycle run here; no Lua, game screens or presets (the
                board's OLED shows the modem's status). The frames on the
                serial link are specified in protocol/usb-modem.md.

        config ATALAIA_POD_MODE
            bool "I/O pod (capability proxy for a phone)"
            help
                A Heltec V4 that lends its team buttons, keypad, LED ring,
                sound, NFC reader, enclosure switch and LoRa radio to an
                Android phone over USB or Bluetooth LE (ADR-P3-3,
                protocol/capability-proxy.md). No Lua, screens, presets or
                Wi-Fi; the radio is the USB modem's code.
    endchoice

    # ---- Buttons (active-low GPIOs) -----------------------------------------
    menu "Buttons"
        config ATALAIA_BTN1_PIN
            int "Button 1 GPIO (-1 = unused)"
            default 4

        config ATALAIA_BTN2_PIN
            int "Button 2 GPIO (-1 = unused)"
            default 48
            help
                GPIO 48 (decision PIN-2). Not GPIO 39: it is the GNSS
                module's TX line (the ESP32's RX). Not GPIO 5: on the Heltec
                V4.3, GPIO 5 is the front-end module's receive-path control
                (CTX).

        config ATALAIA_BTN3_PIN
            int "Button 3 GPIO (-1 = unused)"
            default 44
            help
                GPIO 44, UART0's RX pin (decision PIN-5): with a button on it
                the box reads no console input on UART0; the USB port's
                console (the only one a Heltec V4 has a socket for) is not
                affected. Unwired, the pin's pull-up keeps the button
                released.

        config ATALAIA_BTN4_PIN
            int "Button 4 GPIO (-1 = unused or on the keypad expander)"
            default -1
            help
                -1: button 4 is on the keypad expander's spare pin P7
                (ATALAIA_KP_P7_BUTTON), since the GNSS connector keeps GPIO
                34 and 38-42 (decision PIN-1). A free GPIO here moves it
                back to a GPIO (set ATALAIA_KP_P7_BUTTON to 0 then).

        config ATALAIA_KP_P7_BUTTON
            int "Team button on the keypad expander's P7 (0 = none)"
            depends on ATALAIA_KP_PCF8574
            range 0 4
            default 4
            help
                The team button wired between the PCF8574's spare pin P7
                and GND (decision PIN-4). The keypad scan reads it with the
                keys (no extra I2C traffic); that button's GPIO must be -1.
                It works only when the keypad expander answers at boot.
    endmenu

    # ---- PCF8574 I2C keypad expander ------------------------------------------
    # The 4x3 matrix keypad is wired through a PCF8574 on the shared OLED
    # I2C bus (GPIO 17/18). Rows on P0-P3, columns on P4-P6, P7 is team
    # button 4 (ATALAIA_KP_P7_BUTTON). This frees GPIOs for the audio, the
    # buttons and the display, and leaves the GNSS connector to its module.
    menu "Keypad"
        choice ATALAIA_KP_INTERFACE
            prompt "Keypad interface"
            default ATALAIA_KP_PCF8574
            help
                How the 4x3 keypad is wired. The Field Box uses the PCF8574
                expander. The GPIO matrix exists for the Wokwi emulator
                (sdkconfig.wokwi), which has no PCF8574 part.

            config ATALAIA_KP_PCF8574
                bool "PCF8574 I2C expander (Field Box)"

            config ATALAIA_KP_GPIO_MATRIX
                bool "Direct GPIO matrix (Wokwi emulator)"
        endchoice

        config ATALAIA_KP_ROW0_PIN
            int "Keypad row 1 GPIO (rows are outputs)"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 6
        config ATALAIA_KP_ROW1_PIN
            int "Keypad row 2 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 15
        config ATALAIA_KP_ROW2_PIN
            int "Keypad row 3 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 16
        config ATALAIA_KP_ROW3_PIN
            int "Keypad row 4 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 7
        config ATALAIA_KP_COL0_PIN
            int "Keypad column 1 GPIO (columns are inputs with pull-ups)"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 1
        config ATALAIA_KP_COL1_PIN
            int "Keypad column 2 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 2
        config ATALAIA_KP_COL2_PIN
            int "Keypad column 3 GPIO"
            depends on ATALAIA_KP_GPIO_MATRIX
            default 39

        config ATALAIA_KP_I2C_ADDR
            hex "PCF8574 I2C address"
            depends on ATALAIA_KP_PCF8574
            default 0x20
            help
                7-bit I2C address of the PCF8574 keypad expander, tried
                first. Without an answer there the box looks for it at
                0x20-0x27 (PCF8574, A0-A2 jumpers) and 0x38-0x3F
                (PCF8574A, often sold under the same name), never at
                0x24 (NFC), 0x36 (battery gauge) or 0x3C (OLED).

        config ATALAIA_KP_INT_PIN
            int "PCF8574 INT GPIO (-1 = poll)"
            depends on ATALAIA_KP_PCF8574
            default -1
            help
                Optional interrupt pin from the PCF8574.  When set
                the driver can skip I2C polls when no key change has
                occurred.  Set to -1 to always poll (default).
    endmenu

    # ---- WS2812B LED strip --------------------------------------------------
    menu "LEDs"
        config ATALAIA_LED_PIN
            int "LED data GPIO"
            default 35
            help
                GPIO 35, which also drives the Heltec V4's white LED
                through 330 ohm (decision PIN-3): that LED flickers faintly
                while the ring is updated. Any free output works.

        config ATALAIA_LED_COUNT
            int "Number of LEDs"
            default 24

        config ATALAIA_LED_BRIGHTNESS_PCT
            int "LED ring brightness at boot (percent)"
            default 40
            range 1 100
            help
                WS2812 LEDs have no brightness control of their own: the
                driver scales every colour. A 24-LED ring at full white
                draws about 1.4 A from the battery; modes can change the
                brightness with ring:set_brightness(percent).
    endmenu

    # ---- SPI display --------------------------------------------------------
    menu "Display"
        config ATALAIA_DISP_MOSI_PIN
            int "Display SPI MOSI GPIO"
            default 33

        config ATALAIA_DISP_CLK_PIN
            int "Display SPI CLK GPIO"
            default 47

        config ATALAIA_DISP_CS_PIN
            int "Display SPI CS GPIO"
            default 1
            help
                GPIO 1, the board's battery-voltage ADC input, used as an
                output (decision PIN-3): the divider's 100 kohm to GND on it
                is harmless, and the firmware reads the battery from the
                MAX17048 gauge instead.

        config ATALAIA_DISP_DC_PIN
            int "Display DC GPIO"
            default 3
            help
                GPIO 3 is an ESP32-S3 strapping pin (JTAG source select),
                ignored unless an eFuse asks for it; not burnt on the V4.

        config ATALAIA_DISP_RST_PIN
            int "Display RST GPIO (-1 = tied to 3V3)"
            default -1
            help
                -1 (decision PIN-3): the display's RESET is wired to 3V3 and
                the firmware resets it with the SWRESET command instead. A
                free GPIO here gives it a hardware reset pulse at boot.

        config ATALAIA_DISP_BL_PIN
            int "Display backlight GPIO (-1 = always on, wired to 3V3)"
            default -1
            help
                -1 (decisions M9, PIN-3): a 2.8" panel's backlight draws
                more than a GPIO should source, so its LED pin is wired to
                3V3 and the backlight is on whenever the box is. A GPIO here
                switches it (only through a transistor if it draws more
                than 10 mA).

        choice ATALAIA_DISP_CONTROLLER
            prompt "Display controller IC"
            default ATALAIA_DISP_ILI9341

            config ATALAIA_DISP_ILI9341
                bool "ILI9341"

            config ATALAIA_DISP_ST7789
                bool "ST7789"
        endchoice
    endmenu

    # ---- On-board OLED --------------------------------------------------------
    menu "On-board OLED"
        depends on ATALAIA_NODE_MODE || ATALAIA_MODEM_MODE

        config ATALAIA_OLED_STATUS
            bool "Show a compact status on the board's own OLED"
            default y
            help
                The Heltec V4's 0.96" SSD1306 (128x64, I2C 0x3C on the
                shared bus). On a Field Box it mirrors every screen in three
                lines: header, one big value (PIN, choice, countdown, phase),
                footer. A bare board without the 2.8" TFT can be set up and
                played with it; on a full Field Box it is a status line for
                staff. The TFT keeps the full game screen. On the USB radio
                modem it shows the link to the controller, the game, the
                channel, the packet counts, the duty-cycle budget and any
                radio fault. Without an OLED at the address the firmware logs
                a warning and runs without it.

        config ATALAIA_OLED_ADDR
            hex "OLED I2C address"
            depends on ATALAIA_OLED_STATUS
            default 0x3C

        config ATALAIA_OLED_RST_PIN
            int "OLED reset GPIO (-1 = none)"
            depends on ATALAIA_OLED_STATUS
            default 21
            help
                GPIO 21 on the Heltec V4 (board-internal).

        config ATALAIA_OLED_FLIP
            bool "Rotate the OLED picture by 180 degrees"
            depends on ATALAIA_OLED_STATUS
            default n
            help
                Off: upright with the board's USB port on the left. On:
                for a board mounted the other way round.

        config ATALAIA_OLED_SPLASH_MS
            int "Boot splash time on the OLED (ms, 0 = none)"
            depends on ATALAIA_OLED_STATUS
            default 2000
            range 0 10000
    endmenu

    # ---- NFC (PN532 over I2C, shared bus with OLED and battery gauge) -------
    menu "NFC"
        config ATALAIA_NFC_SDA_PIN
            int "NFC I2C SDA GPIO"
            default 17
            help
                Shares the on-board OLED I2C bus. The PN532 (0x24),
                OLED (0x3C) and MAX17048 (0x36) coexist on this bus.

        config ATALAIA_NFC_SCL_PIN
            int "NFC I2C SCL GPIO"
            default 18
    endmenu

    # ---- I2S audio (MAX98357A) ----------------------------------------------
    # GPIOs 6, 15, 16 are freed from the keypad matrix by the PCF8574
    # I2C expander and reassigned here.
    menu "Audio"
        config ATALAIA_AUDIO_BCLK_PIN
            int "I2S bit-clock GPIO (-1 = audio disabled)"
            default 6
            help
                GPIO 6, freed from keypad. Non-strapping, safe for I2S.

        config ATALAIA_AUDIO_LRCLK_PIN
            int "I2S LR-clock GPIO (-1 = audio disabled)"
            default 15
            help
                GPIO 15, freed from keypad. Non-strapping.

        config ATALAIA_AUDIO_DOUT_PIN
            int "I2S data-out GPIO (-1 = audio disabled)"
            default 16
            help
                GPIO 16, freed from keypad. Non-strapping.
    endmenu

    # ---- Battery gauge (MAX17048 over I2C, shared bus with NFC and OLED) ----
    menu "Battery"
        config ATALAIA_BATT_SDA_PIN
            int "Battery gauge I2C SDA GPIO"
            default 17
            help
                Shares the OLED I2C bus.

        config ATALAIA_BATT_SCL_PIN
            int "Battery gauge I2C SCL GPIO"
            default 18
    endmenu

    # ---- SX1262 LoRa radio (Heltec V4.3 on-board) ---------------------------
    # The SX1262 is on the board's own SPI bus (separate from the display).
    # These are the V4.3 schematic pin assignments.
    menu "Radio"
        config ATALAIA_RADIO_NSS_PIN
            int "SX1262 SPI NSS (CS) GPIO"
            default 8

        config ATALAIA_RADIO_SCK_PIN
            int "SX1262 SPI SCK GPIO"
            default 9

        config ATALAIA_RADIO_MOSI_PIN
            int "SX1262 SPI MOSI GPIO"
            default 10

        config ATALAIA_RADIO_MISO_PIN
            int "SX1262 SPI MISO GPIO"
            default 11

        config ATALAIA_RADIO_RST_PIN
            int "SX1262 RST GPIO"
            default 12

        config ATALAIA_RADIO_BUSY_PIN
            int "SX1262 BUSY GPIO"
            default 13

        config ATALAIA_RADIO_DIO1_PIN
            int "SX1262 DIO1 GPIO"
            default 14

        choice ATALAIA_BOARD_REV
            prompt "Board revision (radio front-end module)"
            default ATALAIA_BOARD_HELTEC_V4_3
            help
                The Heltec WiFi LoRa 32 V4 has two front-end modules between
                the SX1262 and the antenna. Read the chip next to the LoRa
                antenna connector (BRING_UP.md step 0): KCT8103L = V4.3,
                GC1109 = V4.2. The wrong choice leaves the receiver deaf or
                the transmitter weak. Applies to the Field Box, the USB
                radio modem and the I/O pod.

            config ATALAIA_BOARD_HELTEC_V4_3
                bool "Heltec V4.3 (KCT8103L)"

            config ATALAIA_BOARD_HELTEC_V4_2
                bool "Heltec V4.2 (GC1109)"
        endchoice

        config ATALAIA_RADIO_FEM_EN_PIN
            int "FEM chip enable GPIO (FEM_EN, high = on)"
            default 2
            help
                Board-internal: do not reassign. The front-end module's chip
                enable on both V4 revisions.

        config ATALAIA_RADIO_VFEM_CTL_PIN
            int "FEM power GPIO (VFEM_Ctrl, high = powered)"
            default 7
            help
                Board-internal: do not reassign. Switches the LDO that
                powers the front-end module on both V4 revisions; it must be
                high whenever the radio is used. Driven only after the
                SX1262 answers its probe (the Wokwi emulator uses GPIO 7 for
                its keypad).

        config ATALAIA_RADIO_FEM_PA_PIN
            int "GC1109 PA select GPIO (CPS, high = full PA)"
            depends on ATALAIA_BOARD_HELTEC_V4_2
            default 46
            help
                Board-internal on the V4.2: high selects the power amplifier
                (low would bypass it). The SX1262's DIO2 drives the TX/RX
                switch, so no TXEN/RXEN pins are used.

        config ATALAIA_RADIO_FEM_CTX_PIN
            int "KCT8103L receive path GPIO (CTX, low = LNA)"
            depends on ATALAIA_BOARD_HELTEC_V4_3
            default 5
            help
                Board-internal on the V4.3: low puts the receive LNA (about
                21 dB) in the path, high bypasses it. The SX1262's DIO2
                drives the TX/RX switch.

        config ATALAIA_RADIO_FEM_GAIN_DB
            int "FEM gain in dB (for TX power calculation)"
            default 14
            help
                The front-end module provides approximately this much gain.
                Conducted TX power = ERP_limit + 2.15 - FEM_gain - antenna_gain,
                clamped to the SX1262 range [-9, +22] dBm.

        config ATALAIA_RADIO_ANTENNA_GAIN_DBI
            int "Antenna gain in dBi"
            default 2
            help
                Gain of the connected antenna in dBi. A typical stock
                omnidirectional antenna is 2 dBi. This value is subtracted
                from the EIRP limit together with the FEM gain to compute
                the SX1262 conducted TX power. Measure with a calibrated
                antenna analyser for production; the default is a
                conservative estimate for a quarter-wave whip.

        choice ATALAIA_RADIO_REGION
            prompt "Radio regulatory region"
            default ATALAIA_RADIO_REGION_EU868
            help
                The band this board may transmit in (RFC 0001 Amendment 12,
                decisions RF-AS923-1 to RF-AS923-12). The firmware knows only
                this region: a join payload, a modem CONFIGURE or MEASURE on
                another region's channel is refused, so a board built and
                labelled for one band never transmits in another. Fit the
                antenna for the band (an 868 MHz whip is mistuned at 920 MHz).
                Applies to the Field Box, the USB radio modem and the I/O pod.

            config ATALAIA_RADIO_REGION_EU868
                bool "EU868 (Europe, 868-870 MHz, SF7 at 125 kHz)"

            config ATALAIA_RADIO_REGION_AS923_TW
                bool "AS923-TW (Taiwan, 920-925 MHz, SF9 at 500 kHz)"
                help
                    NCC LP0002 5.8.1: LoRa at 500 kHz ("digital modulation":
                    a 6 dB bandwidth of at least 500 kHz), at most 0.5 W
                    peak output at the antenna port outdoors, less the
                    antenna gain above 6 dBi; the 10% airtime budget is this
                    project's own. Not certified: a product sold in Taiwan
                    needs NCC type approval (decision RF-AS923-3).
        endchoice

        config ATALAIA_RADIO_DEFAULT_CHANNEL_HZ
            int "Default game channel frequency (Hz)"
            default 921500000 if ATALAIA_RADIO_REGION_AS923_TW
            default 869525000
            help
                The channel the radio listens on until a game's join payload
                (or the modem's CONFIGURE / SET_CHANNEL) sets the field's
                channel; an unadopted box pairs on its region's default. EU868:
                869.525 MHz, the centre of 869.4-869.65 MHz, the only EU868
                sub-band with 10% duty cycle and 500 mW ERP (RFC 0001 Amendment
                3); the whole 125 kHz channel must fit in one EU868 sub-band, and
                the TX power and the duty-cycle budget follow that sub-band (25
                mW and 1% or 0.1% elsewhere). AS923-TW: 921.5 MHz, clear of
                LoRaWAN's 923.2/923.4 MHz; the whole 500 kHz channel must fit in
                920-925 MHz. An invalid value falls back to the region's default
                with an error at boot.

        config ATALAIA_RADIO_LOG_PACKETS
            bool "Log every packet sent and received (bring-up)"
            default n
            help
                Logs each packet the radio sends (its length and the
                duty-cycle budget left) and receives (its length and RSSI),
                for BRING_UP.md's radio checks with two boards. On in the
                bench variant (sdkconfig.bench); off in a game, where a busy
                field would flood the log.
    endmenu

    # ---- GNSS module on the board's connector (decision PIN-1) ----------------
    # Pins only for now: no driver reads the module yet. A later phase adds it
    # for the modes that need a box's position.
    menu "GNSS"
        config ATALAIA_GNSS_PWR_PIN
            int "GNSS power control GPIO (VGNSS_Ctrl, low = on; -1 = leave alone)"
            default 34
            help
                Board-internal on the Heltec V4: GPIO 34 switches the GNSS
                connector's 3.3 V through a P-MOSFET; the board pulls it high
                (off). The firmware drives it at boot: high (module off)
                unless ATALAIA_GNSS_POWER_ON.

        config ATALAIA_GNSS_POWER_ON
            bool "Power the GNSS module at boot"
            default n
            help
                Off by default: the module draws current and nothing reads
                it yet. A mode that needs a position will switch it on.

        config ATALAIA_GNSS_TX_PIN
            int "GPIO to the module's RX (the ESP32's UART TX)"
            default 38

        config ATALAIA_GNSS_RX_PIN
            int "GPIO from the module's TX (the ESP32's UART RX)"
            default 39

        config ATALAIA_GNSS_WAKE_PIN
            int "GNSS wake-up GPIO (-1 = not used)"
            default 40

        config ATALAIA_GNSS_PPS_PIN
            int "GNSS PPS (pulse per second) GPIO (-1 = not used)"
            default 41

        config ATALAIA_GNSS_RST_PIN
            int "GNSS reset GPIO (active low, -1 = not used)"
            default 42

        config ATALAIA_GNSS_BAUD
            int "GNSS UART baud rate"
            default 9600
            help
                The module's default NMEA rate (9600 baud for the L76K that
                Meshtastic's Heltec V4 support names).
    endmenu

    # ---- Board power ----------------------------------------------------------
    menu "Board power"
        config ATALAIA_VEXT_CTL_PIN
            int "Vext control GPIO (active low, -1 = leave alone)"
            default 36
            help
                Board-internal on the Heltec V4: driving GPIO 36 low switches
                on Vext, the rail for the on-board OLED and the LoRa front
                end (and for external parts wired to it; the standard Field
                Box wiring powers them from 3V3). The firmware drives it low
                early at boot, before anything is probed.
    endmenu

    # ---- Joined games (ADR-P2-12, protocol/join.md) -------------------------
    menu "Field network games"
        config ATALAIA_STATE_INTERVAL_S
            int "Seconds between STATE packets in a joined game"
            default 15
            range 5 300
            help
                A box in a field controller's game sends its owner, phase,
                game time and score counters this often (and at once after
                a capture). 15 s keeps a 5-box game far below the 10% duty
                cycle of the 869.4-869.65 MHz sub-band.

        config ATALAIA_BATTERY_LOW_PCT
            int "Send battery.low below this battery level (percent; 0 = never)"
            default 20
            range 0 99
            help
                In a joined game, a box with a MAX17048 battery gauge sends
                one battery.low event (telemetry: one packet, no ACK) when
                its level falls below this, and again only after the level
                has come back 5 points above it (hysteresis). The gauge is
                read every 10 s; a box without a gauge sends nothing. The
                controller also logs battery.low from the level in STATE if
                the box's own event does not arrive (decisions FU1-3, FU1-6).

        config ATALAIA_CONSOLE_USB_INPUT
            bool "Read the serial console's input from the USB port (USB-Serial-JTAG)"
            default y
            depends on ATALAIA_NODE_MODE
            help
                The Heltec V4 has no USB-UART bridge: its USB-C port is the
                ESP32-S3's own USB-Serial-JTAG. With this on, "@join",
                "@joinkey", "@wifi", "@update" and (with ATALAIA_SERIAL_KEYS) keys typed in a
                serial monitor on that port reach the box, as well as those
                on UART0. Off in the Wokwi build, whose console is UART0.

        config ATALAIA_SERIAL_JOIN
            bool "Accept @join, @joinkey, @tag, @wifi and @update lines on the serial console"
            default y
            help
                "@join atalaia:join:..." joins a game from the text of a join
                payload (the GM console shows it), "@joinkey <64 hex>"
                sets the field join key while no game is joined, and
                "@tag <uid hex> [<tag hex>]" reads a player tag (protocol/nfc-tag.md)
                as if it had been tapped on the NFC reader. "@wifi <ssid> <password>"
                stores the field Wi-Fi a firmware update uses, and
                "@update <version> <release id>" starts one as the controller's
                CMD update does (protocol/firmware-update.md): the same checks. For bring-up and the
                Wokwi emulator; a join still needs a payload signed with this
                box's field join key, and a tag one signed with the game key.
                "@joinkey" follows the adoption rules (protocol/adoption.md):
                it never replaces another field's key.

        config ATALAIA_SERIAL_ADOPT
            bool "Accept @adopt-info and @adopt lines on the serial console (USB adoption)"
            default y
            help
                The field controller adopts a box plugged into it by USB
                (protocol/adoption.md): "@adopt-info" answers one line
                "ATALAIA-ADOPT {json}" with the box's name, MAC and adoption
                state, and "@adopt <64 hex> [<admin PIN>|-] [<field name>]"
                stores the field join key under the adoption rules (an
                unadopted box takes it; another field's box only with its
                admin PIN). On in every Field Box build.

        config ATALAIA_DEV_JOIN_KEY
            string "Development field join key (64 hex digits)"
            default ""
            help
                Used only when no field join key is stored in NVS: for the
                Wokwi emulator and the bench. Leave empty on Field Boxes, which
                are adopted by their field (protocol/adoption.md: the field
                card, the USB cable, "@joinkey"). A box with only this key
                counts as unadopted: the first field to adopt it replaces it.
    endmenu

    # ---- Signed mode packages (protocol/mode-packages.md, phase 5 plan 13) ----
    menu "Mode packages"
        depends on ATALAIA_NODE_MODE

        config ATALAIA_MODE_KEYS
            string "Mode public keys (64 hex digits each, separated by spaces)"
            default "23e9b7acefbe4dc54d86f0c7cc8dbca64340f141a84c94a2f38216420baae0ca d27329d0e19ba0625950cb1b73fca4aa4c5014d76623f6b69389d0e98b1d4c86"
            help
                The Ed25519 public keys whose signatures this firmware accepts
                on a mode package a game needs and the box lacks, fetched from
                its field controller between games (up to 4, for rotation).
                The only keys a box trusts for modes (decision P5B-9: built
                into the firmware, never sent by a controller); a release key
                may be listed here too. Public keys only:
                `python3 tools/mode_package.py keygen` prints this line.
                Empty: every package is refused ("no_key") and a game whose
                mode the box lacks is answered "no mode", as before.
                Default: the project's two registry keys, root d9521a79030ce544
                and CI 7275108d2e3fe583 (docs/community/keys.md).
    endmenu

    # ---- Firmware updates over the air (protocol/firmware-update.md) --------
    menu "Firmware updates (OTA)"
        depends on ATALAIA_NODE_MODE

        config ATALAIA_OTA_RELEASE_KEYS
            string "Release public keys (64 hex digits each, separated by spaces)"
            default ""
            help
                The Ed25519 public keys whose signatures this firmware accepts
                on a firmware release (up to 4, so a key can be rotated: ship a
                release with the old and the new key, then sign with the new
                one). Public keys only: the private keys never come near the
                repository or a build (firmware/esp32/docs/RELEASE_SIGNING.md).
                `python3 tools/firmware_release.py keygen` prints the hex form.
                Empty: the box refuses every update ("no_key"), and an image
                without a key never confirms itself after an update, so the
                bootloader goes back to the previous one.

        config ATALAIA_OTA_VARIANT
            string "Variant name in the image's descriptor (at most 11 characters)"
            default "box-dev" if ATALAIA_KP_GPIO_MATRIX
            default "box-bench" if ATALAIA_SERIAL_KEYS || ATALAIA_SKIP_SETUP
            default "box"
            help
                Written into the image (main/fw_desc.c) next to the board
                revision. A box installs only an image of its own variant and
                board: a bench or Wokwi build never lands on a Field Box, nor
                a V4.2 image on a V4.3 (their radio front ends differ).

        config ATALAIA_OTA_MIN_BATTERY_PCT
            int "Refuse an update below this battery level (percent; 0 = never)"
            default 30
            range 0 90
            help
                With a MAX17048 battery gauge fitted; a box without one
                updates whatever its supply. A power loss during the download
                leaves the running image untouched anyway; this avoids
                starting an update that will not finish.

        config ATALAIA_OTA_WIFI_TIMEOUT_S
            int "Seconds to wait for the field Wi-Fi"
            default 20
            range 5 120
    endmenu

    # ---- USB radio modem (ADR-P2-4) -----------------------------------------
    menu "USB radio modem"
        depends on ATALAIA_MODEM_MODE

        choice ATALAIA_MODEM_LINK
            prompt "Serial link to the controller"
            default ATALAIA_MODEM_LINK_USB_SERIAL_JTAG
            depends on ATALAIA_MODEM_MODE
            help
                The ESP32-S3's built-in USB-Serial-JTAG port (GPIO 19/20), or
                UART0 (GPIO 43/44) for boards with a USB-UART bridge chip.
                With UART0 the console must move off UART0
                (CONFIG_ESP_CONSOLE_NONE or USB_SERIAL_JTAG).

            config ATALAIA_MODEM_LINK_USB_SERIAL_JTAG
                bool "USB-Serial-JTAG (native USB)"

            config ATALAIA_MODEM_LINK_UART0
                bool "UART0 (USB-UART bridge on GPIO 43/44)"
        endchoice

        config ATALAIA_MODEM_UART_BAUD
            int "UART0 baud rate"
            default 921600
            depends on ATALAIA_MODEM_LINK_UART0

        config ATALAIA_MODEM_LINK_TIMEOUT_S
            int "Seconds without a host frame before the OLED shows LINK DOWN"
            default 12
            range 2 120
            help
                The field controller pings the modem every 5 s
                (ping_interval_s) and reconnects after three missed pings.
                12 s is two missed pings and some slack: a link that shows
                DOWN has really stopped, and the screen says so before the
                controller gives up. Only the OLED uses it.

    endmenu

    config ATALAIA_MODEM_EPOCH_WINDOW
        int "Receive epoch window (USB radio modem and I/O pod)"
        default 16
        range 1 64
        depends on ATALAIA_MODEM_MODE || ATALAIA_POD_MODE
        help
            How many epochs above a box's last known epoch the modem (or an
            I/O pod's radio) tries when a packet does not authenticate
            (ADR-P2-2 tries only one). A box that rebooted several times out
            of range would otherwise never be heard again. Never a lower epoch.

    # ---- I/O pod (ADR-P3-3, protocol/capability-proxy.md) -------------------
    # The pod uses the Field Box's pins for its buttons, keypad expander, LED
    # ring, NFC reader, battery gauge, amplifier and radio. It has no display,
    # so the display's GPIOs (1, 3, 33, 47) are free on a pod.
    menu "I/O pod"
        depends on ATALAIA_POD_MODE

        config ATALAIA_POD_BTN1_TEAM
            string "Colour of button 1 (empty: the game's 1st team)"
            default ""
            help
                Empty (the default): button N stands for the game's N-th
                team, as on a Field Box. A colour (red, blue, green, yellow,
                orange, purple, white, pink, cyan) goes into the button's
                descriptor in IDENT, and the phone uses it when the game has
                a team of that name. Which buttons are fitted follows their
                pins (Buttons menu, -1 = not fitted).

        config ATALAIA_POD_BTN2_TEAM
            string "Colour of button 2 (empty: the game's 2nd team)"
            default ""

        config ATALAIA_POD_BTN3_TEAM
            string "Colour of button 3 (empty: the game's 3rd team)"
            default ""

        config ATALAIA_POD_BTN4_TEAM
            string "Colour of button 4 (empty: the game's 4th team)"
            default ""

        config ATALAIA_POD_TAMPER_PIN
            int "Enclosure switch GPIO (-1 = none)"
            default 47
            help
                A switch between this GPIO and GND that the closed lid holds
                closed (the pin has its pull-up on). Opening the enclosure
                sends the "case" capability's "opened" event, which the phone
                reports as node.tamper. The switch is armed only once it has
                read closed, so a pod built without one never reports a
                tamper. GPIO 47 is the Field Box's display clock; a pod
                has no display.

        config ATALAIA_POD_TAMPER_OPEN_HIGH
            bool "The switch's pin reads high when the enclosure is open"
            default y
            help
                With the switch to GND and the pull-up, an open switch reads
                high. Turn this off for a switch wired the other way.

        config ATALAIA_POD_BLE
            bool "Bluetooth LE link"
            default y
            help
                The pod's GATT service (protocol/capability-proxy.md), next to
                the USB link. Off: USB only (turn CONFIG_BT_ENABLED off too to
                leave the Bluetooth stack out of the image).

        config ATALAIA_POD_BLE_ENCRYPTED
            bool "Frames only on an encrypted Bluetooth link"
            default y
            depends on ATALAIA_POD_BLE
            help
                The pod asks the phone to pair (LE Secure Connections, Just
                Works: the pod has no display; bonded) and takes Pod RX writes
                and sends frames only once the link is encrypted, so the game
                key in RADIO_CMD CONFIGURE never crosses the air in the clear.
                Off only for bench tests with tools that cannot pair.
    endmenu

    # ---- Development and emulator options -----------------------------------
    menu "Development"
        config ATALAIA_RADIO_DISABLE
            bool "Disable SX1262 radio HAL (Wokwi emulator)"
            default n
            help
                Skip all radio SPI and GPIO initialisation at boot. Use this
                on the Wokwi emulator, whose DevKitC-1 part has no SX1262
                and whose flash emulation does not tolerate probing SPI3.

        config ATALAIA_RADIO_DEBUG_STEP
            int "Radio init debug bisect step (0 = normal, 1-6 = stop after step N)"
            default 0
            depends on !ATALAIA_RADIO_DISABLE
            help
                Bisect the radio init for Wokwi debugging. 0 = normal full
                init. 1 = SPI bus init only. 2 = + SPI device add. 3 = + GPIO
                config (RST, BUSY, DIO1 without ISR). 4 = + DIO1 ISR install.
                5 = + reset pulse and BUSY wait. 6 = + first SPI transaction
                (SyncWord probe). Remove or set to 0 for production.

        config ATALAIA_SKIP_SETUP
            bool "Skip the Wi-Fi setup portal (use default settings)"
            default n
            help
                Boot straight into the preset picker with the default admin
                PIN (1234) instead of opening the setup portal on first boot.
                For the Wokwi emulator, which cannot host a SoftAP. Leave off
                on real Field Boxes.

        config ATALAIA_LBT
            bool "Listen before talk (a CAD and the receiver's state before every transmission)"
            default y
            help
                RFC 0001 Amendment 14, decision SL-25. Before a frame goes on air
                the radio task asks the radio whether the channel is busy (a frame
                being received, or one CAD). If it is, the frame waits a random
                20-200 ms and the radio is asked again, up to 8 times; then it is
                sent anyway. Collision avoidance only: the duty-cycle budget
                (10 % on the game's sub-band) is spent by the real send and is not
                changed by it. Applies to every image that transmits: the Field
                Box, the USB modem and the I/O pod. With it off the radio task is
                what it was (a frame goes at once). For a field test that compares
                the two, build the same commit twice: docs/runbooks/radio-field-test.md.

        config ATALAIA_LBT_BENCH
            bool "Bench test of listen-before-talk (\"@lbt\" console commands)"
            default n
            help
                Decision SL-25: the gain of a CAD before every transmission holds
                only if the radio's busy test also covers a frame already being
                received. With this on, "@lbt tx" makes a board send frames of a
                STATE's length at random gaps and "@lbt probe" makes another call
                the HAL's channel_busy() every few milliseconds, receive them and
                print what it found ("LBT," lines, read by tools/bench_lbt_gate.py).
                Nothing runs until a command is typed; the radio is the test's
                until it ends. On in the bench variant (sdkconfig.bench) only:
                never for a box in a game. docs/runbooks/lbt-bench-gate.md.

        config ATALAIA_SERIAL_KEYS
            bool "Accept keypad keys from the serial console"
            default n
            help
                Characters 0-9, * and # typed on the USB serial console act
                as keypad presses. Lets the Wokwi automation scenarios and a
                bring-up session drive the picker without touching the keypad.
    endmenu

    # ---- Memory tier --------------------------------------------------------
    choice ATALAIA_MEMORY_TIER
        prompt "Lua heap memory tier"
        default ATALAIA_MEMORY_TIER_FULL

        config ATALAIA_MEMORY_TIER_FULL
            bool "Full (256 KB)"
            help
                Allocates 256 KB for the Lua sandbox heap.
                Requires PSRAM; falls back to reduced tier at runtime
                if PSRAM is not detected.

        config ATALAIA_MEMORY_TIER_REDUCED
            bool "Reduced (64 KB)"
            help
                Allocates 64 KB for the Lua sandbox heap.
                Suitable for boards without PSRAM (e.g. Heltec V3).
    endchoice

endmenu
