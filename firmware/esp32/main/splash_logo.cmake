#
# atalaia_splash_logo(<splash .pgm> <output .c>) writes a C source with the boot splash
# (oled_logo_a8, oled_logo.h): the 30x60 image of a plain-text PGM ("P2"), one byte per pixel,
# 0xFF where the value is 128 or more and 0x00 below. The Field Box and the USB modem draw it on the
# on-board OLED's boot screen, and the big screen's "ready" screens draw it (scaled) in their
# header colour. The project's default is assets/splash.pgm (the Atalaia towers); a builder's own
# is CONFIG_ATALAIA_SPLASH_LOGO (README.md, "Your own splash logo"). A file that is not 30x60 P2
# stops the build with a message saying so. Used by main/CMakeLists.txt (the device) and
# test/CMakeLists.txt (the host tests, always with the default).

function(atalaia_splash_logo pgm out)
    if(NOT EXISTS "${pgm}")
        message(FATAL_ERROR "splash logo: ${pgm} does not exist (CONFIG_ATALAIA_SPLASH_LOGO)")
    endif()
    file(STRINGS "${pgm}" lines)
    set(tokens "")
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "#.*$" "" line "${line}")
        string(STRIP "${line}" line)
        if(NOT line STREQUAL "")
            string(REGEX REPLACE "[ \t\r]+" ";" parts "${line}")
            list(APPEND tokens ${parts})
        endif()
    endforeach()
    list(LENGTH tokens count)
    if(count LESS 4)
        message(FATAL_ERROR "splash logo: ${pgm} is not a plain-text PGM (P2, 30 60, 255, then 1800 values)")
    endif()
    list(GET tokens 0 magic)
    list(GET tokens 1 width)
    list(GET tokens 2 height)
    list(GET tokens 3 maxval)
    if(NOT magic STREQUAL "P2" OR NOT width EQUAL 30 OR NOT height EQUAL 60)
        message(FATAL_ERROR "splash logo: ${pgm} must be a plain-text PGM (first line P2) of exactly 30 x 60 pixels, not ${magic} ${width} x ${height}")
    endif()
    if(maxval LESS 1 OR maxval GREATER 65535)
        message(FATAL_ERROR "splash logo: ${pgm}: the maximum value ${maxval} is not 1 to 65535")
    endif()
    math(EXPR want "4 + 30 * 60")
    if(NOT count EQUAL want)
        math(EXPR have "${count} - 4")
        message(FATAL_ERROR "splash logo: ${pgm} has ${have} pixel values, 1800 are needed (30 x 60)")
    endif()
    # Lit from half the maximum value up.
    math(EXPR half "(${maxval} + 1) / 2")
    set(bytes "")
    set(row "")
    set(n 0)
    list(SUBLIST tokens 4 1800 values)
    foreach(v IN LISTS values)
        if(NOT v MATCHES "^[0-9]+$" OR v GREATER maxval)
            message(FATAL_ERROR "splash logo: ${pgm}: \"${v}\" is not a value from 0 to ${maxval}")
        endif()
        if(v GREATER_EQUAL half)
            string(APPEND row "0xFF,")
        else()
            string(APPEND row "0x00,")
        endif()
        math(EXPR n "${n} + 1")
        if(n EQUAL 30)
            string(APPEND bytes "    ${row}\n")
            set(row "")
            set(n 0)
        endif()
    endforeach()
    set(text "/* Generated by splash_logo.cmake from ${pgm}. Do not edit. */\n/* clang-format off */\n#include \"oled_logo.h\"\n\nconst uint8_t oled_logo_a8[OLED_LOGO_W * OLED_LOGO_H] = {\n${bytes}};\n")
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL text)
        file(WRITE "${out}" "${text}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pgm}")
endfunction()
