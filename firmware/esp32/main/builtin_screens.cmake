#
# atalaia_builtin_screens(<modes dir> <output .c>) writes a C source with
# every <modes dir>/<mode>/assets/screens/<name>.yaml as an entry of
# builtin_screens[] (builtin_screens.h): the mode id from its mode.yaml, the
# template name and the bytes. Used by main/CMakeLists.txt (the device) and
# test/CMakeLists.txt (the host tests), so both carry the same templates.
# Editing a template or adding one re-runs CMake.

function(atalaia_builtin_screens modes_dir out)
    file(GLOB yamls CONFIGURE_DEPENDS "${modes_dir}/*/assets/screens/*.yaml")
    list(SORT yamls)
    set(arrays "")
    set(table "")
    set(count 0)
    foreach(path IN LISTS yamls)
        get_filename_component(screens_dir "${path}" DIRECTORY)
        get_filename_component(assets_dir "${screens_dir}" DIRECTORY)
        get_filename_component(mode_dir "${assets_dir}" DIRECTORY)
        file(STRINGS "${mode_dir}/mode.yaml" id_line REGEX "^id:")
        string(REGEX REPLACE "^id:[ ]*([A-Za-z0-9._-]+).*$" "\\1" mode_id "${id_line}")
        if(mode_id STREQUAL "" OR mode_id STREQUAL id_line)
            message(FATAL_ERROR "${mode_dir}/mode.yaml: no id")
        endif()
        get_filename_component(name "${path}" NAME_WE)
        file(READ "${path}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR len "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "static const unsigned char screen_${count}[] = {${bytes}0x00};\n")
        string(APPEND table "    {\"${mode_id}\", \"${name}\", (const char *)screen_${count}, ${len}},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}" "${mode_dir}/mode.yaml")
        math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
        set(table "    {0, 0, 0, 0},\n")
    endif()
    set(text "/* Generated by builtin_screens.cmake from modes/<mode>/assets/screens/. Do not edit. */\n")
    string(APPEND text "/* clang-format off */\n#include \"builtin_screens.h\"\n\n${arrays}\n")
    string(APPEND text "const builtin_screen_t builtin_screens[] = {\n${table}};\n")
    string(APPEND text "const int builtin_screen_count = ${count};\n")
    # Rewritten only when it changes, so an unrelated CMake run rebuilds nothing.
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL text)
        file(WRITE "${out}" "${text}")
    endif()
endfunction()
