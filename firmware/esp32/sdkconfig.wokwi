#
# Wokwi emulator variant, applied on top of sdkconfig.defaults:
#   python tools/docker_fw.py wokwi
# builds it into build-wokwi/, which wokwi.toml and diagram.json use.
# It never changes the real board's defaults.
#
# Wokwi's ESP32-S3-DevKitC-1 has no PCF8574, PN532, MAX17048, SX1262 or I2S
# amplifier, and GPIO 33/34 are not on its headers. See docs/WOKWI.md.

# The keypad sits on a GPIO matrix instead of the PCF8574 expander: rows on
# 6, 15, 16, 7 and columns on 1, 2, 39. GPIO 6/15/16 are the audio pins,
# free here because Wokwi does not simulate the I2S amplifier.
CONFIG_ATALAIA_KP_GPIO_MATRIX=y
CONFIG_ATALAIA_KP_ROW0_PIN=6
CONFIG_ATALAIA_KP_ROW1_PIN=15
CONFIG_ATALAIA_KP_ROW2_PIN=16
CONFIG_ATALAIA_KP_ROW3_PIN=7
CONFIG_ATALAIA_KP_COL0_PIN=1
CONFIG_ATALAIA_KP_COL1_PIN=2
CONFIG_ATALAIA_KP_COL2_PIN=39

# Audio off: its pins carry the keypad.
CONFIG_ATALAIA_AUDIO_BCLK_PIN=-1
CONFIG_ATALAIA_AUDIO_LRCLK_PIN=-1
CONFIG_ATALAIA_AUDIO_DOUT_PIN=-1

# Two teams: GPIO 33/34 are not on the DevKitC-1 headers.
# diagram.json wires button 2 to GPIO 5. The Field Box default moved to GPIO 39
# (GPIO 5 is the Heltec V4.3 FEM's CTX pin), but here 39 is a keypad column and
# the emulator has no FEM: the FEM pins are driven only after an SX1262 answers.
CONFIG_ATALAIA_BTN2_PIN=5
CONFIG_ATALAIA_BTN3_PIN=-1
CONFIG_ATALAIA_BTN4_PIN=-1

# Wokwi does not simulate the ILI9341 RST pin, and GPIO 38 drives the
# DevKitC-1's own RGB LED.
CONFIG_ATALAIA_DISP_RST_PIN=-1

# The radio probes the SX1262 at boot, logs "SX1262 not detected" and
# carries on. No CONFIG_ATALAIA_RADIO_DISABLE needed: the init is safe
# on the DevKitC-1 board (bisect confirmed steps 1-6 pass; root cause
# of the earlier crash was an infinite BUSY-wait loop on a floating
# GPIO, fixed by adding a 200-iteration timeout to sx_wait_busy).

# No SoftAP captive portal in the emulator: start with the default settings
# (admin PIN 1234), and accept keypad keys from the serial console so the
# automation scenarios can type them.
CONFIG_ATALAIA_SKIP_SETUP=y
CONFIG_ATALAIA_SERIAL_KEYS=y

# Keep booting if the emulated board has no PSRAM (diagram.json asks for 2 MB).
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# A field game can be joined from the serial console ("@join ..."): the join
# scenario (wokwi/join.scenario.yaml) signs its payload with this public test
# key (protocol/vectors/join.json). Never set it on a real Field Box.
CONFIG_ATALAIA_DEV_JOIN_KEY="000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

# The emulated board's console is UART0; the USB-Serial-JTAG input of the
# Field Box build (CONFIG_ATALAIA_CONSOLE_USB_INPUT) is not used here.
# CONFIG_ATALAIA_CONSOLE_USB_INPUT is not set
