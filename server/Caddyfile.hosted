# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Caddy in front of a hosted hub (ADR-P4-4 as built, plan phase 21; Phase 4
# follow-up, decisions FU4-*; server/docs/DEPLOY.md, "Hosted mode"). Used by
# server/docker-compose.hosted.yml in place of server/Caddyfile.
#
# Every field is at https://<slug>.ATALAIA_DOMAIN (one DNS label; the DNS
# needs a wildcard record *.ATALAIA_DOMAIN pointing at this machine). Caddy
# gets each field's own certificate the first time a client asks for that
# name (on-demand TLS), and only after the `ask` endpoint (the tls-ask
# service, atalaia_server/tls_ask.py) says the name is an active field's:
# nobody can make the hub request certificates for names of their choosing,
# and a flood of made-up names is rate limited there. The hub's own name and
# any other name get no certificate at all. Values come from server/.env:
#   ATALAIA_DOMAIN  the hub's domain (hub.example.pt)
#   ATALAIA_TLS     acme (default: public certificates, HTTP-01 or TLS-ALPN-01
#                   per name) or internal (Caddy's own CA: the deployment test)
# A field may also have one custom host name (decisions PKC-6; DEPLOY.md,
# "Custom domains"): the operator sets it (`hosted domain set`), proves the
# field controls it by a DNS TXT record (`hosted domain verify`), and only then
# does the `ask` endpoint say yes to it, so the second site block below (any
# other name that reaches this machine) can get a certificate for exactly the
# registered, verified names and no others.
# A wildcard certificate from a DNS challenge instead needs a Caddy built with
# that DNS provider's plugin: server/docs/DEPLOY.md, "One wildcard certificate".

(tls-acme) {
	tls {
		on_demand
	}
}

(tls-internal) {
	tls internal {
		on_demand
	}
}

{
	# No admin endpoint: nothing changes this configuration at run time.
	admin off
	on_demand_tls {
		# 200 only for an active field's <slug>.ATALAIA_DOMAIN; reachable only on the internal network.
		ask http://tls-ask:8001/check
	}
}

(hub-site) {
	import tls-{$ATALAIA_TLS:acme}

	# As server/Caddyfile: the server sends its own security headers; Caddy
	# adds what it does not and hides the software versions.
	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
		-Via
		-X-Powered-By
		defer
	}

	# The server caps request bodies itself (atalaia_server/body_limit.py: 1 MiB, 4 MiB on the image uploads); this
	# is the first line of defence, above the largest upload, so a huge body never reaches the one worker (SRV-2).
	request_body {
		max_size 5MB
	}

	# The Host header goes on unchanged: the server picks the field from it
	# (an unknown field: 404 unknown_field, a suspended one: 403).
	reverse_proxy server:8000 {
		stream_close_delay 5m
	}
}

*.{$ATALAIA_DOMAIN} {
	import hub-site
}

# A field's custom host name: any name that is not <slug>.ATALAIA_DOMAIN. It
# gets a certificate only if the `ask` endpoint knows it as an active field's
# verified name; any other name fails the TLS handshake as it did before.
https:// {
	import hub-site
}

# The hub's own name serves the social login relay's one path when ATALAIA_OIDC_RELAY=on (decision LG-14):
# docker-compose.hosted.yml mounts relay-on.caddy or relay-off.caddy as /etc/caddy/relay.caddy, by that setting.
# Off, the hub's own name serves nothing and gets no certificate, as before.
(apex-tls-acme) {
}

(apex-tls-internal) {
	tls internal
}

import /etc/caddy/relay.caddy
