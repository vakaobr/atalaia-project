#
# The site server's direct dependencies (decision P4R16). requirements.txt is
# made from this file with every package pinned to a version and its PyPI
# hashes; the image installs it with pip --require-hashes. Only releases at
# least two weeks old are taken (--exclude-newer). To refresh both files, from
# the repository root:
#   docker run --rm -v "$PWD/server:/w" -w /w python:3.12.14-slim sh -c '
#     pip install -q uv==0.9.30 &&
#     for f in requirements requirements-test; do
#       uv pip compile --python-version 3.12 --exclude-newer YYYY-MM-DD --generate-hashes \
#         --no-header $f.in -o $f.txt; done'
# then put the SPDX header back at the top of both .txt files and run the
# tests (python3 tools/docker_server.py test).
fastapi
uvicorn
# uvicorn's WebSocket protocol, for WS /api/v1/sync/stream (the remote GM, plan phase 19, decision S19-1):
# pure Python on h11, which uvicorn already uses.
wsproto
sqlalchemy[asyncio]
asyncpg
alembic
# Accounts (ADR-P4-2, plan phase 11): Argon2id passwords, access tokens, TOTP.
argon2-cffi
PyJWT
pyotp
# Imported by the code shared with the controller: the mode loader, the chrono verifier.
PyYAML
cryptography
# Sign-in without a password (plan: login methods, LG-*): passkeys (WebAuthn).
webauthn
