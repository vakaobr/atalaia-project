# Build context of server/Dockerfile (the repository root): only what the
# image copies, never build output, caches or secrets.
*
!core/
!simulator/atalaia_sim/
!controller/atalaia_controller/
!app/lib/chrono/limit_templates/
!modes/
!protocol/vectors/sync.json
!protocol/vectors/chrono_record.json
!protocol/vectors/apd.json
!registry/apds/apds.json
!server/requirements.txt
!server/requirements-test.txt
!server/atalaia_server/
!server/migrations/
!server/alembic.ini
!server/schemas/
!server/tests/
**/__pycache__
**/*.pyc
core/build*
core/third_party/lua/*.o
