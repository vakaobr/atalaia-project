        bgame["{{ arch.t031 }}"]
        bnet["{{ arch.t032 }}"]
        bphy["{{ arch.t033 }}"]
    end
    subgraph ct["{{ arch.t034 }}"]
        cgame["{{ arch.t035 }}"]
        cser["{{ arch.t036 }}"]
    end
    subgraph md["{{ arch.t037 }}"]
        mnet["{{ arch.t038 }}"]
        mphy["{{ arch.t033 }}"]
    end
    subgraph pd["{{ arch.t039 }}"]
        pnet["{{ arch.t040 }}"]
        pphy["{{ arch.t033 }}"]
    end
    air(("{{ arch.t041 }}"))
    bgame --- bnet --- bphy
    mnet --- mphy
    pnet --- pphy
    cgame --- cser
    bphy <-->|"{{ arch.t016 }}"| air
    mphy <-->|"{{ arch.t016 }}"| air
    pphy <-->|"{{ arch.t016 }}"| air
    cser <-->|"{{ arch.t042 }}"| mnet
    cser <-.->|"{{ arch.t043 }}"| pnet
