#
# Writes the scenario compiler's Lua sources into a C file (decision PE24-109):
#   cmake -DOUT=scenario_sources.c -DSOURCES="a.lua|b.lua" -P embed_scenario.cmake
# Each file becomes a byte array (so no compiler's limit on string literals
# applies) and an entry of atalaia_scenario_sources (src/scenario_sources.h),
# named by the file's name without .lua. Run by the core's build whenever a
# source changes; CMake alone, so the Android build (Gradle and the NDK's
# CMake) needs no other tool.

# The list comes with | between its files (a ; would split the command's argument).
string(REPLACE "|" ";" SOURCES "${SOURCES}")
set(body "/* Generated by core/cmake/embed_scenario.cmake from the Lua files of core/scenario: do not edit. */\n")
string(APPEND body "#include \"scenario_sources.h\"\n\n")
set(entries "")
set(count 0)
foreach(path IN LISTS SOURCES)
    get_filename_component(name "${path}" NAME_WE)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR len "${hex_len} / 2")
    # 0x.., per byte (on one line: CMake's regular expressions have no {n}), then a NUL
    # that is not counted.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const unsigned char src_${name}[] = {\n    ${bytes}0x00};\n\n")
    string(APPEND entries "    {\"${name}\", (const char *)src_${name}, ${len}u},\n")
    math(EXPR count "${count} + 1")
endforeach()
string(APPEND body "const atalaia_scenario_source_t atalaia_scenario_sources[] = {\n${entries}};\n")
string(APPEND body "const size_t atalaia_scenario_source_count = ${count}u;\n")
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
